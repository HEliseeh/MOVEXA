# Copier ce fichier en .env et remplir les valeurs. Le .env n'est jamais commité.
DB_PASSWORD=
REGISTRY_PASSWORD=

# Clé de signature des jetons de connexion (base64, 512 bits), identique pour le gateway et le back1.
# Générer : openssl rand -base64 64 | tr -d '\n'
JWT_BASE64_SECRET=

# Mot de passe du compte « admin » au premier démarrage en prod (10 caractères minimum).
# Utilisé seulement tant que l'admin a encore le mot de passe « admin ».
FLEXCLUBMANAGEMENT_ADMIN_INITIAL_PASSWORD=

# ---- E-mails (« Mot de passe oublié ») ----
# Par défaut : Mailpit, boîte de test sur http://localhost:8025 (rien ne part vraiment).
# En production, un vrai serveur SMTP, par exemple Brevo :
#   MAIL_HOST=smtp-relay.brevo.com  MAIL_PORT=587  MAIL_SMTP_AUTH=true  MAIL_STARTTLS=true
#   MAIL_USERNAME=<identifiant SMTP>  MAIL_PASSWORD=<clé SMTP>
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=
MAIL_STARTTLS=
# Expéditeur affiché dans les e-mails
MAIL_FROM=
# Adresse publique de l'application (liens des e-mails), ex. https://app.flexclub.bj
APP_URL=
